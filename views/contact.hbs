


<section class="contact-main">
            <article class="contact-hero">
                <h1>Get In Touch</h1>
                <p>Educational support only. Ask trading questions.</p>
            </article>
            
            <section class="contact-form-section">
                
                <form class="contact-form" action="http://foo.com" method="get">
                    <article class="form-group">
                        <label>Name <span style="color:red;">*</span></label>
                        <input type="text" name="name" placeholder="Your name" required>
                    </article>
                    <article class="form-group">
                        <label>Email <span style="color:red;">*</span></label>
                        <input type="email" name="email" placeholder="your@email.com" required>
                    </article>
                    <article class="form-group">
                        <label>Message <span style="color:red;">*</span></label>
                        <textarea name="message" placeholder="Your question about trading..." required></textarea>
                    </article>
                    <article class="form-group radio-group">
                        <label>Support Type</label>
                        <label><input type="radio" name="support" value="beginner"> Beginner</label>
                        <label><input type="radio" name="support" value="tools"> Tools</label>
                        <label><input type="radio" name="support" value="blueprint"> Blueprint</label>
                    </article>
                    <button type="submit" class="btn-primary full">Send Message</button>
                </form>
            </section>
        </section>
    </main>
